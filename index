<div class="chatbot-container">
<div class="chatbot-window" id="chatbotWindow">
<div class="chatbot-header">
<div class="chatbot-avatar"><i class="fas fa-robot"></i></div>
<div class="chatbot-header-info"><h4>Facilito Bot</h4><p>Asistente Virtual - En linea</p></div>
<button class="chatbot-close" onclick="toggleChatbot()"><i class="fas fa-times"></i></button>
</div>
<div class="chatbot-messages" id="chatMessages">
<div class="message bot">
Hola! Soy el asistente virtual de <strong>Facilito Solutions</strong>.<br><br>
Estoy aqui para ayudarte con:
<div class="message-time">Ahora</div>
</div>
</div>
<div class="quick-replies" id="quickReplies">
<button class="quick-reply" onclick="sendQuickReply('Que servicios ofrecen?')">Servicios?</button>
<button class="quick-reply" onclick="sendQuickReply('Cuentame sobre los planes')">Ver Planes</button>
<button class="quick-reply" onclick="sendQuickReply('Como contactarlos?')">Contacto</button>
<button class="quick-reply" onclick="sendQuickReply('Quiero una cotizacion')">Cotizacion</button>
</div>
<div class="chatbot-input">
<input type="text" id="chatInput" placeholder="Escribe tu mensaje..." onkeypress="handleChatKeypress(event)">
<button class="chatbot-send" onclick="sendMessage()"><i class="fas fa-paper-plane"></i></button>
</div>
</div>
<button class="chatbot-toggle" id="chatbotToggle" onclick="toggleChatbot()">
<i class="fas fa-comment-dots"></i>
<div class="notification"></div>
</button>
</div>

<script>
function createParticles() {
    const container = document.getElementById('particles');
    for (let i = 0; i < 30; i++) {
        const particle = document.createElement('div');
        particle.className = 'particle';
        particle.style.left = Math.random() * 100 + '%';
        particle.style.animationDuration = (Math.random() * 10 + 10) + 's';
        particle.style.animationDelay = (Math.random() * 10) + 's';
        particle.style.width = (Math.random() * 4 + 2) + 'px';
        particle.style.height = particle.style.width;
        container.appendChild(particle);
    }
}
createParticles();

window.addEventListener('scroll', () => {
    const navbar = document.getElementById('navbar');
    if (window.scrollY > 50) navbar.classList.add('scrolled');
    else navbar.classList.remove('scrolled');
});

const observerOptions = { threshold: 0.1, rootMargin: '0px 0px -50px 0px' };
const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => { if (entry.isIntersecting) entry.target.classList.add('visible'); });
}, observerOptions);
document.querySelectorAll('.fade-in').forEach(el => observer.observe(el));

let chatOpen = false;
function toggleChatbot() {
    const win = document.getElementById('chatbotWindow');
    chatOpen = !chatOpen;
    win.classList.toggle('active', chatOpen);
    if (chatOpen) setTimeout(() => document.getElementById('chatInput').focus(), 300);
}

const botResponses = {
    'servicios': 'Ofrecemos 3 servicios principales:<br><br><strong>Auditoria Integral:</strong> Revision completa de tu area de RRHH, identificacion de brechas y plan de accion.<br><br><strong>Montaje y Estandarizacion:</strong> Creamos flujos, manuales, formatos y procedimientos claros.<br><br><strong>Automatizacion:</strong> Transformamos tareas manuales en procesos digitales con robots y sistemas a la medida.',
    'planes': 'Tenemos 6 planes disenados para cada necesidad:<br><br><strong>Plan 1:</strong> Diagnostico y recomendaciones<br><strong>Plan 2:</strong> Auditoria completa + estandarizacion<br><strong>Plan 3:</strong> Automatizacion de procesos (Mas popular)<br><strong>Plan 4:</strong> Full Service completo<br><strong>Plan 5:</strong> Outsourcing de RRHH total<br><strong>Plan 6:</strong> Consultoria PILA y afiliaciones<br><br>Te gustaria que te explique alguno en detalle?',
    'contacto': 'Puedes contactarnos de estas formas:<br><br><strong>Email:</strong> facilitosolutions@gmail.com<br><strong>Telefono:</strong> 313-438-9198<br><strong>Ubicacion:</strong> Bogota D.C, Colombia<br><br>Tambien puedes llenar el formulario de contacto en la pagina y te responderemos en menos de 24 horas.',
    'cotizacion': 'Perfecto! Para darte una cotizacion personalizada necesito saber:<br><br>1. Cuantos colaboradores tiene tu empresa?<br>2. Que proceso de RRHH te genera mas dolor hoy?<br>3. Estas interesado en algun plan especifico?<br><br>Tambien puedes llenar el formulario de contacto y un asesor se comunicara contigo.',
    'nosotros': 'Facilito Solutions nacio con una intencion clara: ordenar, optimizar y transformar el area de RRHH.<br><br>Contamos con mas de una decada de experiencia en gestion real del talento en campo, oficinas y operacion.<br><br>Nuestra mision es elevar el nivel del Talento Humano de cada empresa, garantizando precision, control y una operacion moderna.',
    'default': 'Gracias por tu mensaje. Para ayudarte mejor, elige una de estas opciones:<br><br>- Escribe "servicios" para conocer lo que ofrecemos<br>- Escribe "planes" para ver nuestros paquetes<br>- Escribe "contacto" para hablar con nosotros<br>- Escribe "cotizacion" para recibir una propuesta'
};

function getBotResponse(text) {
    const lower = text.toLowerCase();
    if (lower.includes('servicio') || lower.includes('ofrecen') || lower.includes('hacen')) return botResponses['servicios'];
    if (lower.includes('plan') || lower.includes('precio') || lower.includes('costo') || lower.includes('paquete')) return botResponses['planes'];
    if (lower.includes('contacto') || lower.includes('llamar') || lower.includes('email') || lower.includes('telefono') || lower.includes('ubicacion')) return botResponses['contacto'];
    if (lower.includes('cotiz') || lower.includes('presupuesto') || lower.includes('cuanto cuesta')) return botResponses['cotizacion'];
    if (lower.includes('quien') || lower.includes('empresa') || lower.includes('nosotros') || lower.includes('historia')) return botResponses['nosotros'];
    if (lower.includes('hola') || lower.includes('buenas') || lower.includes('hi') || lower.includes('hey')) return 'Hola! Bienvenido a Facilito Solutions. En que puedo ayudarte hoy?';
    if (lower.includes('gracias') || lower.includes('thank')) return 'Con gusto! Hay algo mas en lo que pueda ayudarte?';
    if (lower.includes('adios') || lower.includes('chao') || lower.includes('bye')) return 'Hasta luego! Quedo atento si necesitas algo mas. Que tengas un excelente dia!';
    return botResponses['default'];
}

function sendMessage() {
    const input = document.getElementById('chatInput');
    const text = input.value.trim();
    if (!text) return;
    addMessage(text, 'user');
    input.value = '';
    showTyping();
    setTimeout(() => { hideTyping(); addMessage(getBotResponse(text), 'bot'); }, 1000 + Math.random() * 1000);
}

function sendQuickReply(text) {
    addMessage(text, 'user');
    showTyping();
    setTimeout(() => { hideTyping(); addMessage(getBotResponse(text), 'bot'); }, 800);
}

function addMessage(text, type) {
    const container = document.getElementById('chatMessages');
    const message = document.createElement('div');
    message.className = 'message ' + type;
    const time = new Date().toLocaleTimeString('es-CO', { hour: '2-digit', minute: '2-digit' });
    message.innerHTML = text + '<div class="message-time">' + time + '</div>';
    container.appendChild(message);
    container.scrollTop = container.scrollHeight;
}

function showTyping() {
    const container = document.getElementById('chatMessages');
    const typing = document.createElement('div');
    typing.className = 'typing-indicator';
    typing.id = 'typingIndicator';
    typing.innerHTML = '<span></span><span></span><span></span>';
    container.appendChild(typing);
    container.scrollTop = container.scrollHeight;
}

function hideTyping() {
    const typing = document.getElementById('typingIndicator');
    if (typing) typing.remove();
}

function handleChatKeypress(e) {
    if (e.key === 'Enter') sendMessage();
}

function selectPlan(planName) {
    document.getElementById('contacto').scrollIntoView({ behavior: 'smooth' });
    const select = document.getElementById('plan-select');
    const planMap = {
        'Plan 1: Diagnostico': 'Plan 1',
        'Plan 2: Auditoria Completa': 'Plan 2',
        'Plan 3: Automatizacion': 'Plan 3',
        'Plan 4: Full Service': 'Plan 4',
        'Plan 5: RRHH Outsourcing': 'Plan 5',
        'Plan 6: PILA y Afiliaciones': 'Plan 6'
    };
    if (planMap[planName]) select.value = planMap[planName];
}

function handleContactSubmit(e) {
    e.preventDefault();
    const nombre = document.querySelector('.contact-form input[type="text"]').value;
    const empresa = document.querySelectorAll('.contact-form input[type="text"]')[1].value;
    const email = document.querySelector('.contact-form input[type="email"]').value;
    const telefono = document.querySelector('.contact-form input[type="tel"]').value;
    const plan = document.getElementById('plan-select').value;
    const mensaje = document.querySelector('.contact-form textarea').value;

    let texto = 'Hola Facilito Solutions! Me interesa su servicio de Tercerizacion Inteligente de RRHH.';
    texto += '%0A%0A*Nombre:* ' + encodeURIComponent(nombre || 'No especificado');
    texto += '%0A*Empresa:* ' + encodeURIComponent(empresa || 'No especificado');
    texto += '%0A*Email:* ' + encodeURIComponent(email || 'No especificado');
    texto += '%0A*Telefono:* ' + encodeURIComponent(telefono || 'No especificado');
    texto += '%0A*Plan de interes:* ' + encodeURIComponent(plan || 'No especificado');
    if (mensaje) texto += '%0A%0A*Mensaje:* ' + encodeURIComponent(mensaje);

    window.open('https://wa.me/573134389198?text=' + texto, '_blank');
}

function toggleMobileMenu() {
    alert('Menu movil - Navega por las secciones usando los enlaces del sitio.');
}

document.querySelectorAll('a[href^="#"]').forEach(anchor => {
    anchor.addEventListener('click', function(e) {
        e.preventDefault();
        const target = document.querySelector(this.getAttribute('href'));
        if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
});

setTimeout(() => {
    if (!chatOpen) {
        const toggle = document.getElementById('chatbotToggle');
        toggle.style.animation = 'pulse-notification 1s 3';
    }
}, 5000);
</script>
</body>
</html>